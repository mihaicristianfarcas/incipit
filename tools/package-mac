#!/bin/sh
# Makes the macOS package, on a Mac: target/package/Incipit.app (the bundle) and
# target/package/Incipit-VERSION-ARCH.dmg (the disk image a learner downloads, with the bundle and a
# shortcut to Applications to drag it to), for the Mac's own kind of processor.
#
#   tools/setup            once: pdfium's library for this Mac, which goes inside the bundle
#   tools/package-mac
#
# Needs the Rust toolchain, `cargo install --locked cargo-about --features cli` (the licence
# notice), and the tools every Mac has (codesign, hdiutil, plutil). It needs no developer account.
#
# Unsigned: the bundle is signed ad hoc, which gives it a valid seal and no identity, so a Mac that
# has downloaded it asks the person to allow it once (docs/packaging.md). With
# CODESIGN_IDENTITY set to the name of a Developer ID certificate in the keychain, the same script
# signs with it for the hardened runtime instead; notarising is not scripted (docs/packaging.md).
#
# The bundle's layout:
#   Contents/MacOS/incipit              the program
#   Contents/Frameworks/libpdfium.dylib what draws PDFs (found by src/resources.rs)
#   Contents/Resources/incipit.icns     the icon
#   Contents/Resources/licenses/        Incipit's licence, the notice of what is inside, pdfium's
#   Contents/Info.plist                 name, identifier, version, the books it opens
set -eu
. "$(dirname "$0")/package-common"

[ "$(uname -s)" = Darwin ] || package_fail "this makes the macOS package and runs on a Mac"
library="$package_root/lib/lib/libpdfium.dylib"
[ -f "$library" ] || package_fail "pdfium's library is missing from lib/; run tools/setup"

case "$(uname -m)" in
    arm64) arch=arm64 ;;
    x86_64) arch=x86_64 ;;
    *) package_fail "no package for $(uname -m)" ;;
esac
version=$(package_version)
app="$package_out/Incipit.app"
dmg="$package_out/Incipit-$version-$arch.dmg"

package_build ""
program="$(package_target_dir "")/incipit"

# The oldest macOS the bundle runs on: the newer of what the program and pdfium were built for.
minimum_of() { otool -l "$1" | awk '/LC_BUILD_VERSION/ { found = 1 } found && /minos/ { print $2; exit }'; }
minimum=$(printf '%s\n%s\n' "$(minimum_of "$program")" "$(minimum_of "$library")" | sort -t. -k1,1n -k2,2n | tail -1)

rm -rf "$app" "$dmg"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Frameworks" "$app/Contents/Resources"
cp "$program" "$app/Contents/MacOS/incipit"
cp "$library" "$app/Contents/Frameworks/libpdfium.dylib"
cp "$package_root/packaging/icon/incipit.icns" "$app/Contents/Resources/incipit.icns"
package_licenses "$app/Contents/Resources/licenses"
sed -e "s/@VERSION@/$version/g" -e "s/@IDENTIFIER@/$(package_identifier)/g" -e "s/@MINIMUM@/$minimum/g" \
    "$package_root/packaging/macos/Info.plist.in" >"$app/Contents/Info.plist"
plutil -lint "$app/Contents/Info.plist" >/dev/null

# Signing goes from the inside out: the library, then the bundle that holds it and the program.
identity=${CODESIGN_IDENTITY:--}
if [ "$identity" = - ]; then
    codesign --force --sign - "$app/Contents/Frameworks/libpdfium.dylib"
    codesign --force --sign - "$app"
else
    codesign --force --options runtime --timestamp --sign "$identity" "$app/Contents/Frameworks/libpdfium.dylib"
    codesign --force --options runtime --timestamp --sign "$identity" "$app"
fi
codesign --verify --strict "$app"

# The disk image: the bundle and a shortcut to /Applications, compressed with LZMA (macOS 10.15 or later reads it; the bundle needs 13).
stage="$package_out/dmg"
rm -rf "$stage"
mkdir -p "$stage"
cp -R "$app" "$stage/Incipit.app"
ln -s /Applications "$stage/Applications"
hdiutil create -quiet -volname Incipit -srcfolder "$stage" -fs HFS+ -format ULMO -ov "$dmg"
rm -rf "$stage"
(cd "$package_out" && shasum -a 256 "$(basename "$dmg")" >"$(basename "$dmg").sha256")

echo
echo "Bundle:     $app ($(package_size "$app"), macOS $minimum or later)"
echo "Disk image: $dmg ($(package_size "$dmg"))"
